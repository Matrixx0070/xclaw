{
  "name": "xclaw",
  "version": "3.130.0",
  "description": "XClaw autonomous agent gateway",
  "type": "module",
  "bin": {
    "xclaw": "./bin/xclaw.mjs"
  },
  "scripts": {
    "start": "node bin/xclaw.mjs gateway",
    "gateway": "node bin/xclaw.mjs gateway",
    "computer": "node bin/xclaw.mjs computer",
    "status": "node bin/xclaw.mjs status",
    "doctor": "node bin/xclaw.mjs doctor",
    "test": "node --test test/**/*.test.mjs",
    "self-test": "node bin/xclaw.mjs self-test",
    "eval": "node bin/xclaw.mjs eval",
    "eval:mock": "node bin/xclaw.mjs eval --mock",
    "eval:ci": "node scripts/eval-ci.mjs",
    "eval:suite": "node scripts/eval-suite.mjs",
    "package": "node scripts/package-release.mjs",
    "self-check": "node scripts/self-check.mjs --allow-warn",
    "dev-up": "node scripts/dev-up.mjs",
    "eval:campaign": "node scripts/eval-campaign.mjs",
    "soak": "node scripts/soak-run.mjs",
    "evidence": "node scripts/evidence-release.mjs",
    "skill-ab": "node scripts/skill-ab.mjs",
    "soak:nights": "node scripts/soak-multinight.mjs",
    "queue:load": "node scripts/queue-load.mjs",
    "fire-drill": "node scripts/fire-drill.mjs",
    "sandbox-redteam": "node scripts/sandbox-redteam.mjs",
    "soak:7": "SOAK_NIGHTS=7 SOAK_MIN_NIGHTS=7 node scripts/soak-multinight.mjs",
    "release-gate": "node scripts/release-gate.mjs",
    "release-gate:quick": "node scripts/release-gate.mjs --quick",
    "release-gate:strict": "node scripts/release-gate.mjs --strict",
    "phase5": "node scripts/release-gate.mjs --quick",
    "eval:regression": "node scripts/eval-regression.mjs",
    "docker:build": "docker build -t xclaw:3.1.0 .",
    "docker:publish": "node scripts/docker-publish.mjs",
    "docker:push": "node scripts/docker-publish.mjs --push",
    "a6": "node scripts/a-enforcement-e2e.mjs",
    "a-enforcement": "node scripts/a-enforcement-e2e.mjs",
    "live-e2e": "node scripts/live-enforcement-e2e.mjs",
    "live-enforcement": "node scripts/live-enforcement-e2e.mjs",
    "release-gate:live": "node scripts/release-gate.mjs --live",
    "check-bundle-markers": "node -e \"const fs=require('fs');const p='src/computer/xclaw-server.mjs';if(!fs.existsSync(p)){console.log('SKIP: bundle not installed (opt-in artifact \u2014 npm run fetch:bundle)');process.exit(0)}const t=fs.readFileSync(p,'utf8');const m=['A2: driver hooks','A4: humanized CDP motor','A5: single Chrome argv'];const miss=m.filter(x=>!t.includes(x));if(miss.length){console.error('MISSING',miss);process.exit(2)}console.log('OK markers',m.join(', '));\"",
    "live-e2e:cron": "node bin/xclaw.mjs live-e2e",
    "live-e2e:schedule": "node bin/xclaw.mjs live-e2e-schedule",
    "build:computer": "node scripts/build-computer-bundle.mjs",
    "computer:build": "node scripts/build-computer-bundle.mjs",
    "fetch:bundle": "node scripts/fetch-computer-bundle.mjs",
    "publish:bundle": "node scripts/publish-bundle.mjs",
    "init": "node src/cli/init.mjs",
    "onboard": "node src/cli/init.mjs",
    "install:local": "bash install/install.sh --yes",
    "prove:install": "node scripts/prove-install-e2e.mjs",
    "p2:eval": "node scripts/p2-multistep-eval.mjs",
    "p2:swarm": "node scripts/p2-swarm-receipt.mjs",
    "p2:prod": "node scripts/p2-prod-fire-drill.mjs",
    "p2": "node scripts/p2-swarm-receipt.mjs && node scripts/p2-prod-fire-drill.mjs && node --test test/search-plane.test.mjs",
    "p3:skills": "node scripts/p2-skills-smoke.mjs",
    "p3": "node scripts/p2-skills-smoke.mjs",
    "skills:smoke": "node scripts/p2-skills-smoke.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "ui/",
    "skills/",
    "docs/",
    "README.md",
    "XCLAW.md",
    "OPS.md",
    "THIRD_PARTY.md",
    "package.json",
    "eval/",
    "INSTALL.md",
    "CHANGELOG.md",
    "deploy/"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "xclaw",
    "agent",
    "computer-use",
    "gateway"
  ]
}
