[
  {
    "id": "a4-G01-write-read",
    "tags": ["autonomy", "a4", "shell", "verify"],
    "prompt": "Create a file named a4-hello.txt in the current workspace containing exactly: autonomy-ok. Then read it back with a tool and confirm the contents. Do not ask the user for help.",
    "maxTurns": 8,
    "timeoutMs": 120000,
    "expect": {
      "success": [{ "type": "file_contains", "path": "a4-hello.txt", "contains": "autonomy-ok" }],
      "budgets": { "maxTurns": 8 }
    }
  },
  {
    "id": "a4-G02-multi-step",
    "tags": ["autonomy", "a4", "shell"],
    "prompt": "Create numbers.txt with lines 1,2,3 (one number per line). Then create sum.txt containing the sum of those numbers as a single integer. Verify both files. No user questions.",
    "maxTurns": 10,
    "timeoutMs": 150000,
    "expect": {
      "success": [
        { "type": "file_exists", "path": "numbers.txt" },
        { "type": "file_contains", "path": "sum.txt", "contains": "6" }
      ]
    }
  },
