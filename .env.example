# XClaw environment template
# Copy to `.env` (gitignored) or export in the shell. Never commit real secrets.
# Docker compose uses `deploy/env.example` instead — copy that to `deploy/.env`.
# Full secret hygiene: docs/SECRETS.md
#
# This file lists the names THIS repo actually reads. It is not an OpenClaw /
# Electron template: there is no TAVILY_API_KEY, no BRAVE_SEARCH_API_KEY, and
# no electron-builder rebuild. Search is Brave (`BRAVE_API_KEY`) with a
# DuckDuckGo fallback. Vector search is opt-in sqlite-vec (`XCLAW_SQLITE_VEC`).

# ---------------------------------------------------------------------------
# LLM providers (at least one required for live agent turns)
# ---------------------------------------------------------------------------
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Optional aliases some scripts also accept:
# XAI_KEY=
# GROK_API_KEY=

# ---------------------------------------------------------------------------
# Gateway / profile / sandbox
# ---------------------------------------------------------------------------
# lab | dev | prod — lab is the first-run default
XCLAW_PROFILE=lab
# Required when profile=prod or any non-loopback bind
XCLAW_GATEWAY_TOKEN=
# Override bind-guard for a trusted unpublished network only (never on exposed ports)
# XCLAW_GATEWAY_ALLOW_OPEN=1

# OS sandbox for bash (bubblewrap). auto | bwrap | off
# prod prefers bwrap when installed and usable. See docs/OS_SANDBOX.md
XCLAW_OS_SANDBOX=auto
# Egress for network-capable shell: deny | allow | allowlist
# XCLAW_EGRESS=deny
# Bash child env: strip-secrets (default) | allowlist | inherit
# XCLAW_BASH_ENV=strip-secrets

# Optional sqlite-vec native extension (NOT shipped in this repo).
# Default memory index never loads extensions. Set memory.vec=true in config
# AND point this at a host-built sqlite-vec shared library, or place one at
# native/sqlite-vec. There is no electron-builder / postinstall rebuild.
# XCLAW_SQLITE_VEC=

# ---------------------------------------------------------------------------
# Search plane (optional). Brave first; DuckDuckGo lite if unset.
# ---------------------------------------------------------------------------
BRAVE_API_KEY=
# XCLAW_BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# Channels (all optional; enable in ~/.xclaw/xclaw.json as well)
# Recovery runbook: docs/CHANNEL_RECOVERY.md
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# XCLAW_TELEGRAM_TOKEN=
# XCLAW_TELEGRAM_WEBHOOK_URL=
# XCLAW_TELEGRAM_WEBHOOK_SECRET=
# XCLAW_TELEGRAM_OWNER_CHAT_ID=

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# XCLAW_SLACK_TOKEN=
# XCLAW_SLACK_APP_TOKEN=
# XCLAW_SLACK_HEARTBEAT_MS=90000

DISCORD_BOT_TOKEN=
# XCLAW_DISCORD_TOKEN=

EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Model / API override
# ---------------------------------------------------------------------------
# XCLAW_MODEL=xai/grok-4.5
# XCLAW_API_BASE=
# XCLAW_API_KEY=

# ---------------------------------------------------------------------------
# Durable SQL paths (defaults under ~/.xclaw — leave unset unless relocating)
# ---------------------------------------------------------------------------
# XCLAW_CONTROL_PLANE_FILE=
# XCLAW_MEMORY_INDEX_FILE=
# XCLAW_STATE_DIR=
