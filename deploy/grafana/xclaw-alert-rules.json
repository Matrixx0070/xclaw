{
  "apiVersion": 1,
  "groups": [
    {
      "name": "xclaw-slack-ws",
      "interval": "1m",
      "rules": [
        {
          "uid": "xclaw-slack-idle",
          "title": "XClaw Slack WS idle high",
          "condition": "A",
          "for": "2m",
          "annotations": {
            "summary": "Slack Socket Mode idle exceeds 90s"
          },
          "labels": { "severity": "warning", "service": "xclaw" },
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "prometheus",
              "model": {
                "expr": "xclaw_slack_ws_idle_ms > 90000",
                "instant": true,
                "refId": "A"
              }
            }
          ]
        },
        {
          "uid": "xclaw-slack-reconnect-storm",
          "title": "XClaw Slack reconnect storm",
          "condition": "A",
          "for": "5m",
          "annotations": {
            "summary": "More than 10 reconnects in 15 minutes"
          },
          "labels": { "severity": "warning", "service": "xclaw" },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 900, "to": 0 },
              "datasourceUid": "prometheus",
              "model": {
                "expr": "increase(xclaw_slack_ws_reconnects_total[15m]) > 10",
                "instant": true,
                "refId": "A"
              }
            }
          ]
        },
        {
          "uid": "xclaw-computer-down",
          "title": "XClaw computer server down",
          "condition": "A",
          "for": "2m",
          "annotations": {
            "summary": "Computer process not healthy"
          },
          "labels": { "severity": "critical", "service": "xclaw" },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "prometheus",
              "model": {
                "expr": "xclaw_computer_up == 0",
                "instant": true,
                "refId": "A"
              }
            }
          ]
        }
      ]
    }
  ]
}
