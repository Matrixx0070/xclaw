# deploy/.env — copy to .env (never commit real secrets)
#
# Try-me (lab, auto-approve tools):
#   XCLAW_PROFILE=lab
#   XAI_API_KEY=xai-...
#
# Production-ish:
#   XCLAW_PROFILE=prod
#   XCLAW_GATEWAY_TOKEN=<openssl rand -hex 32>
#   XAI_API_KEY=xai-...

XAI_API_KEY=
XCLAW_API_KEY=
XCLAW_MODEL=
XCLAW_API_BASE=

# lab | dev | prod — lab is default for first run
XCLAW_PROFILE=lab

# Required when XCLAW_PROFILE=prod (or any public exposure)
XCLAW_GATEWAY_TOKEN=

# Host port mappings (compose defaults shown)
# XCLAW_GATEWAY_PORT=18790
# XCLAW_COMPUTER_PORT=4243

# Optional: protect Prometheus scrape
# XCLAW_PROTECT_METRICS=1
