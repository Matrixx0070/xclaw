# XClaw nightly horizon live soak (install under /etc/cron.d/xclaw-horizon-soak)
# Requires: XCLAW_API_KEY, XCLAW_SOAK_MAX_USD, XCLAW_SOAK_MAX_TURNS
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
0 3 * * * root cd /opt/xclaw && XCLAW_SOAK_MAX_USD=${XCLAW_SOAK_MAX_USD:-2} XCLAW_SOAK_MAX_TURNS=${XCLAW_SOAK_MAX_TURNS:-8} node src/eval/horizon-cli.mjs --live --confirm-live --all >> /var/log/xclaw-horizon-soak.log 2>&1
