diff --git a/src/gateway/sse-fanout.mjs b/src/gateway/sse-fanout.mjs
--- a/src/gateway/sse-fanout.mjs
+++ b/src/gateway/sse-fanout.mjs
@@ -76,11 +76,41 @@
     };
   }
 
+  function closeRoom(room, reason = "kill") {
+    const key = String(room || "default");
+    const r = rooms.get(key);
+    if (!r) return { closed: 0, room: key };
+    let closed = 0;
+    for (const [sid, sub] of [...r.entries()]) {
+      try {
+        if (isSSEOpen(sub.res)) sendSSE(sub.res, "session_killed", { reason, room: key }, `kill-${sid}`);
+        sub.res.end?.();
+      } catch { /* */ }
+      r.delete(sid);
+      closed += 1;
+    }
+    rooms.delete(key);
+    return { closed, room: key, reason };
+  }
+
+  function closeAll(reason = "kill_all") {
+    const roomsClosed = [];
+    for (const key of [...rooms.keys()]) {
+      roomsClosed.push(closeRoom(key, reason));
+    }
+    rooms.clear();
+    return {
+      reason,
+      rooms: roomsClosed.length,
+      subscribers: roomsClosed.reduce((n, x) => n + x.closed, 0),
+    };
+  }
+
   function clear() {
     rooms.clear();
   }
 
-  return { subscribe, publish, publishAll, stats, clear };
+  return { subscribe, publish, publishAll, stats, clear, closeRoom, closeAll };
 }

