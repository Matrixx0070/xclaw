# XClaw Agent Swarm Environment Configuration
# Copy to .env.swarm and fill in your values

# LLM Provider (required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
XAI_API_KEY=xai-...

# Base URLs (optional — for custom endpoints)
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
XAI_BASE_URL=https://api.x.ai/v1

# Redis (required)
REDIS_URL=redis://localhost:6379/0
REDIS_RESULT_URL=redis://localhost:6379/1

# Swarm API Keys (comma-separated)
SWARM_API_KEYS=swarm-key-1,swarm-key-2

# Docker (for sandboxed sub-agents)
DOCKER_HOST=unix:///var/run/docker.sock

# Telemetry
PROMETHEUS_PORT=9090

# MCP Gateway
MCP_GATEWAY_URL=http://localhost:3001

# Sandbox Security
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_NETWORK_MODE=bridge
