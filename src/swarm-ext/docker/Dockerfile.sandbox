# XClaw Swarm Sandbox — Isolated execution environment for sub-agents
# Uses bubblewrap + minimal Alpine for secure tool execution
FROM alpine:3.19

RUN apk add --no-cache \
    bubblewrap \
    bash \
    curl \
    jq \
    python3 \
    py3-pip \
    nodejs \
    npm \
    git \
    ca-certificates

# Create non-root user for sandbox execution
RUN adduser -D -s /bin/bash xclaw-sandbox

# Sandbox policy directory
RUN mkdir -p /etc/xclaw-sandbox/policies && chmod 755 /etc/xclaw-sandbox

WORKDIR /sandbox

# Default: run a sandboxed bash shell
USER xclaw-sandbox
CMD ["bash", "-c", "echo 'XClaw sandbox ready'; sleep infinity"]
